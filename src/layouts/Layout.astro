---
import Header from "../components/Header.astro";

const { title = "My Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    padding-top: 60px;
  }
</style>